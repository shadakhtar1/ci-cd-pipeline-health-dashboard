# Development defaults for the backend service.
# Copy this file to .env in the same directory before running locally or with Docker Compose.

APP_NAME=ci-cd-dashboard
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db
LOG_LEVEL=INFO

# Optional GitHub integration values. Leave blank unless you want to sync live workflow runs.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional SMTP settings. Leave blank unless you want email alerts enabled.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
TO_EMAIL=alerts@example.com
SMTP_RECIPIENTS=alerts@example.com
EMAIL_ALERTS_ENABLED=false
